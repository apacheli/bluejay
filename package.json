{
  "name": "bluejay",
  "description": "Building static pages made easy.",
  "version": "0.10.0",
  "main": "./lib/main.js",
  "bin": "./lib/bin.js",
  "scripts": {
    "build": "BLUEJAY_MODE=build bun lib/bin.js src/main.js",
    "serve": "BLUEJAY_MODE=serve NODE_ENV=development bun lib/bin.js src/main.js",
    "serve:production": "BLUEJAY_MODE=serve bun lib/bin.js src/main.js"
  },
  "files": [
    "lib"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "@apacheli/jsx": "https://github.com/apacheli/jsx",
    "lightningcss": "^1.33.0"
  }
}
